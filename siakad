#!/usr/bin/env bash
# Titik masuk SIAKAD MCP. Virtualenv dan dependensinya disiapkan sendiri pada
# jalankan pertama.
#
#   ./siakad bap --tahun 2025 --semester 2 --tujuan bukti/pengajaran
#   ./siakad petakan /report/berita_acara_kuliah
#   ./siakad api            # REST API di http://localhost:8000 (PORT=9001 untuk ganti port)
#   ./siakad mcp            # MCP server lewat stdio
#   ./siakad uji            # unit test

set -euo pipefail

AKAR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="${SIAKAD_VENV:-$AKAR/.venv}"
PYTHON="$VENV/bin/python"

# Akar proyek menentukan letak .env, siakad.yaml, dan digital_signs/, serta titik
# hitung path relatif. Bawaannya direktori aplikasi ini sendiri — aplikasi tidak
# pernah menengok ke direktori di atasnya. Ruang kerja yang lebih besar bisa
# menunjuk direktorinya sendiri lewat SIAKAD_AKAR_PROYEK sebelum memanggil ini.
export SIAKAD_AKAR_PROYEK="${SIAKAD_AKAR_PROYEK:-${BKD_AKAR_PROYEK:-$AKAR}}"

if [[ ! -x "$PYTHON" ]]; then
	echo "Membuat virtualenv di $VENV" >&2
	python3 -m venv "$VENV"
fi

# penanda ini ikut berubah setiap pyproject.toml disunting, jadi paket baru
# otomatis terpasang tanpa perlu mengingat menjalankan pip. Dipasang sebagai
# paket (editable) supaya `import siakad_mcp` berperilaku persis seperti di
# proyek lain yang memasangnya dari PyPI.
PENANDA="$VENV/.paket-terpasang"
if [[ ! -f "$PENANDA" || "$AKAR/pyproject.toml" -nt "$PENANDA" ]]; then
	echo "Memasang siakad-mcp beserta dependensinya" >&2
	"$VENV/bin/pip" install --quiet --upgrade pip
	"$VENV/bin/pip" install --quiet -e "$AKAR[semua]"
	touch "$PENANDA"
fi

bantuan() {
	sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \?//'
	exit 2
}

PERINTAH="${1:-}"
[[ -n "$PERINTAH" ]] || bantuan
shift

case "$PERINTAH" in
bap) exec "$PYTHON" -m siakad_mcp.cli "$@" ;;
petakan) exec "$PYTHON" -m siakad_mcp.petakan_form "$@" ;;
api) exec "$VENV/bin/uvicorn" siakad_mcp.api:app --port "${PORT:-8000}" "$@" ;;
mcp) exec "$PYTHON" -m siakad_mcp.mcp_server "$@" ;;
uji) exec "$PYTHON" -m pytest "$AKAR/tests" "$@" ;;
*) bantuan ;;
esac
